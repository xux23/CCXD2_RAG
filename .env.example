# =============================================
# 尝尝咸淡RAG系统 - 环境变量模板
# 复制为 .env 并填入真实值
# =============================================

# OpenAI 兼容中转站地址 (必填, 形如 https://api.xxx.com/v1)
LLM_API_BASE=https://your-relay.example.com/v1

# OpenAI 兼容中转站密钥 (必填)
LLM_API_KEY=sk-your-key-here

# 模型名称 (必填, 按中转站支持的模型填, 例如 deepseek-chat / gpt-4o-mini / qwen-plus)
LLM_MODEL=your-model-name

# 向量模型 (OpenAI兼容端点: 如 text-embedding-v4 / text-embedding-v3; 本地 HF 模型: 如 BAAI/bge-small-zh-v1.5)
EMBEDDING_MODEL=text-embedding-v4

# 可选: HuggingFace 镜像 (国内网络下载 embedding 模型失败时取消注释)
# HF_ENDPOINT=https://hf-mirror.com
